+    # A node only truly re-gates if ALL its outgoing edges are conditional.
+    # If it has a plain (unconditional) edge to an exit node, that plain edge
+    # is a silent escape route -- not a re-gate, even if other edges are conditional.
+    outgoing = list(graph.outgoing_edges(node_id))
+    has_any_conditional = any(e.condition and e.condition.strip() for e in outgoing)
