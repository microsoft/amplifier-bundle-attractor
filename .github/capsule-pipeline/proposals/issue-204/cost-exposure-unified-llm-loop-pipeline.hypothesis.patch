+"""Per-call cost computation for unified_llm.
+
+Public API: compute_cost(model, input_tokens, output_tokens, *,
+                         cache_read_tokens=0, cache_write_tokens=0,
+                         speed=None) -> Decimal | None
+
+Returns None for unrecognised models or when a required rate dimension is
+absent from the catalog data (never 0, never a float, never a partial sum).
+"""
+
+from __future__ import annotations
+
+from decimal import Decimal
+
+# ---------------------------------------------------------------------------
+# Internal rate table
+# ---------------------------------------------------------------------------
+# Maps model-id -> {input_per_m, output_per_m, cache_read_per_m, cache_write_per_m}
+# All values in USD per 1 000 000 tokens.
+#
+# Parity target: matches amplifier_module_provider_anthropic._cost for every
+# model that appears in both tables.  The implementer's choice (criteria
+# delegation) allows this table to live here rather than in a shared package.
+
+_PER_M = Decimal("1_000_000")
+
+_RATES: dict[str, dict[str, Decimal | None]] = {
+    # ------------------------------------------------------------------
+    # Claude Sonnet 4.5 family  ($3 / $15 / $0.30 / $3.75)
+    # ------------------------------------------------------------------
+    "claude-sonnet-4-5": {
+        "input_per_m": Decimal("3.00"),
+        "output_per_m": Decimal("15.00"),
+        "cache_read_per_m": Decimal("0.30"),
+        "cache_write_per_m": Decimal("3.75"),
+    },
+    "claude-sonnet-4-5-20250929": {
+        "input_per_m": Decimal("3.00"),
+        "output_per_m": Decimal("15.00"),
+        "cache_read_per_m": Decimal("0.30"),
+        "cache_write_per_m": Decimal("3.75"),
+    },
+    # ------------------------------------------------------------------
+    # Claude Sonnet 4.6 / 4.7  ($3 / $15 / $0.30 / $3.75)
+    # ------------------------------------------------------------------
+    "claude-sonnet-4-6": {
+        "input_per_m": Decimal("3.00"),
+        "output_per_m": Decimal("15.00"),
+        "cache_read_per_m": Decimal("0.30"),
+        "cache_write_per_m": Decimal("3.75"),
+    },
+    # ------------------------------------------------------------------
+    # Claude Sonnet 5  ($3 / $15 / $0.30 / $3.75)
+    # ------------------------------------------------------------------
+    "claude-sonnet-5": {
+        "input_per_m": Decimal("3.00"),
+        "output_per_m": Decimal("15.00"),
+        "cache_read_per_m": Decimal("0.30"),
+        "cache_write_per_m": Decimal("3.75"),
+    },
+    # ------------------------------------------------------------------
+    # Claude Opus 4.5 / 4.6 / 4.7 / 4.8 / 5  ($5 / $25 / $0.50 / $6.25)
+    # ------------------------------------------------------------------
+    "claude-opus-4-5": {
+        "input_per_m": Decimal("5.00"),
+        "output_per_m": Decimal("25.00"),
+        "cache_read_per_m": Decimal("0.50"),
