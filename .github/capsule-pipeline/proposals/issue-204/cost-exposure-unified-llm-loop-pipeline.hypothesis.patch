+        usage.output_tokens,
+        cache_read_tokens=[REDACTED:assignment] or 0,
+        cache_write_tokens=[REDACTED:assignment] or 0,
+    )
+    new_usage = replace(usage, cost_usd=cost_usd)
+    return replace(response, usage=new_usage)
