+        "cache_write_per_m": Decimal("18.75"),
+    },
+}
+
+# Models for which the 2x fast-mode multiplier applies when speed=='fast'.
+_FAST_ELIGIBLE_MODELS: frozenset[str] = frozenset(
+    {
+        "claude-opus-4-6",
+        "claude-opus-4-7",
+        "claude-opus-4-8",
+        "claude-opus-5",
+    }
+)
+
+
+def compute_cost(
+    model: str,
+    input_tokens: int,
+    output_tokens: int,
+    *,
+    cache_read_tokens: int = 0,
+    cache_write_tokens: int = 0,
+    speed: str | None = None,
+) -> Decimal | None:
+    """Return the USD cost for an LLM API call as a :class:`~decimal.Decimal`.
+
+    Parameters
+    ----------
+    model:
+        Model identifier (e.g. ``"claude-sonnet-4-5-20250929"``).
+    input_tokens:
+        Fresh (non-cached) input tokens consumed.
+    output_tokens:
+        Output tokens generated.
+    cache_read_tokens:
+        Tokens served from the prompt cache (maps to cache_read_input_tokens
+        in the Anthropic API usage object).
+    cache_write_tokens:
+        Tokens written to the prompt cache (maps to cache_creation_input_tokens
+        in the Anthropic API usage object).
+    speed:
+        When ``'fast'`` AND the model supports fast mode, a 2x multiplier is
+        applied; any other value leaves cost unchanged.
+
+    Returns
+    -------
+    Decimal | None
+        The computed cost in USD, or ``None`` if *model* is not recognised or
+        a required rate dimension is absent.  ``None`` is semantically distinct
+        from ``Decimal('0')`` (a free call).
+    """
+    rates = _RATES.get(model)
+    if rates is None:
+        return None
+
+    input_per_m = rates.get("input_per_m")
+    output_per_m = rates.get("output_per_m")
+
+    # If either base rate is None, we cannot compute a valid cost.
+    if input_per_m is None or output_per_m is None:
+        return None
+
+    cost = (
+        Decimal(input_tokens) * input_per_m / _PER_M
+        + Decimal(output_tokens) * output_per_m / _PER_M
+    )
+
+    if cache_read_tokens > 0:
+        cache_read_per_m = rates.get("cache_read_per_m")
+        if cache_read_per_m is None:
+            return None
+        cost += Decimal(cache_read_tokens) * cache_read_per_m / _PER_M
+
+    if cache_write_tokens > 0:
+        cache_write_per_m = rates.get("cache_write_per_m")
+        if cache_write_per_m is None:
+            return None
+        cost += Decimal(cache_write_tokens) * cache_write_per_m / _PER_M
+
+    if speed == "fast" and model in _FAST_ELIGIBLE_MODELS:
+        cost *= 2
+
+    return cost
