@@ -12,7 +12,54 @@ from unified_llm.middleware import (
     apply_streaming_middleware,
 )
 from unified_llm.stream_validation import validate_stream
-from unified_llm.types import Request, Response, StreamEvent
+from unified_llm.types import Request, Response, StreamEvent, Usage
+
+
+def _attach_cost(response: Response) -> Response:
+    """Attach cost_usd to response.usage if not already set.
+
+    Computes cost from the response's model and usage token counts using
+    unified_llm.compute_cost. If the model is not recognised or a required
+    rate dimension is unavailable, cost_usd remains None (AC-2 contract).
+
+    This is the computing layer for AC-3: the adapter need not know about
+    cost; the Client layer attaches it after every complete() call.
+    """
+    if response.usage.cost_usd is not None:
+        # Already computed (e.g. by the adapter itself) — do not overwrite.
+        return response
+    try:
+        from unified_llm._cost import compute_cost
+        cost = compute_cost(
+            response.model,
+            response.usage.input_tokens,
+            response.usage.output_tokens,
+            cache_read_tokens=response.usage.cache_read_tokens or 0,
+            cache_write_tokens=response.usage.cache_write_tokens or 0,
+        )
+    except Exception:
+        cost = None
+    new_usage = Usage(
+        input_tokens=response.usage.input_tokens,
+        output_tokens=response.usage.output_tokens,
+        total_tokens=response.usage.total_tokens,
+        reasoning_tokens=response.usage.reasoning_tokens,
+        cache_read_tokens=response.usage.cache_read_tokens,
+        cache_write_tokens=response.usage.cache_write_tokens,
+        cost_usd=cost,
+        raw=response.usage.raw,
+    )
+    return Response(
+        id=response.id,
+        model=response.model,
+        provider=response.provider,
+        message=response.message,
+        finish_reason=response.finish_reason,
+        usage=new_usage,
+        raw=response.raw,
+        warnings=response.warnings,
+        rate_limit=response.rate_limit,
+    )
 
 # Module-level default client (Spec §2.5)
 _default_client: Client | None = None
@@ -58,7 +105,8 @@ class Client:
         async def handler(req: Request) -> Response:
             return await adapter.complete(req)
 
-        return await apply_middleware(self._middleware, handler, request)
+        response = await apply_middleware(self._middleware, handler, request)
+        return _attach_cost(response)
 
     async def stream(self, request: Request) -> AsyncIterator[StreamEvent]:
         """Low-level streaming call. No retry. (Spec §4.2)."""
