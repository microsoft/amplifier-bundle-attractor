+        "input_per_m": Decimal("3.00"),
+        "output_per_m": Decimal("15.00"),
+        "cache_read_per_m": Decimal("0.30"),
+        "cache_write_per_m": Decimal("3.75"),
+    },
+    "claude-opus-4-20250514": {
+        "input_per_m": Decimal("15.00"),
+        "output_per_m": Decimal("75.00"),
+        "cache_read_per_m": Decimal("1.50"),
+        "cache_write_per_m": Decimal("18.75"),
+    },
+}
+
+# Models for which the 2x fast-mode multiplier applies when speed=='fast'.
+# Mirrors the oracle's _FAST_ELIGIBLE_MODELS.
+_FAST_ELIGIBLE_MODELS: frozenset[str] = frozenset({
+    "claude-opus-4-6",
+    "claude-opus-4-7",
+    "claude-opus-4-8",
+    "claude-opus-5",
+})
+
+
+def compute_cost(
+    model: str,
+    input_tokens: int,
+    output_tokens: int,
+    *,
+    cache_read_tokens: int = 0,
+    cache_write_tokens: int = 0,
+    speed: str | None = None,
+) -> Decimal | None:
+    """Compute the USD cost for an LLM call.
+
+    Parameters
+    ----------
+    model:
+        Model identifier (e.g. ``"claude-sonnet-4-5-20250929"``).
+    input_tokens:
+        Fresh (non-cached) input tokens consumed.
+    output_tokens:
+        Output tokens generated.
+    cache_read_tokens:
+        Tokens served from the prompt cache.
+    cache_write_tokens:
+        Tokens written to the prompt cache.
+    speed:
+        When ``'fast'`` AND *model* is fast-eligible, a 2x multiplier applies.
+
+    Returns
+    -------
+    Decimal | None
+        The computed cost in USD as a Decimal, or None if:
+        - the model is not recognised, or
+        - a required rate dimension is unavailable for this model.
+        Never 0 (as a sentinel), never a float, never a partial computation.
+    """
+    rates = _RATES.get(model)
+
+    if rates is None:
+        # Model not in internal table — try catalog as fallback for
+        # basic input/output cost (no cache rates available from catalog).
+        # AC-2: if a required rate dimension is None, return None.
+        try:
+            from unified_llm.catalog import get_model_info
+            info = get_model_info(model)
+        except Exception:
+            info = None
+
+        if info is None:
+            return None
+
+        # Catalog has input_cost_per_million and output_cost_per_million.
+        # If either is None, return None (AC-2: missing rate dimension).
+        if info.input_cost_per_million is None:
+            return None
+        if info.output_cost_per_million is None:
+            return None
+
+        # Cache rates not available from catalog — if caller requests cache
+        # tokens, return None (rate dimension unavailable).
+        if cache_read_tokens > 0 or cache_write_tokens > 0:
+            return None
+
+        cost = (
+            Decimal(input_tokens) * Decimal(str(info.input_cost_per_million)) / _PER_M
+            + Decimal(output_tokens) * Decimal(str(info.output_cost_per_million)) / _PER_M
+        )
+        return cost
+
+    # Internal rate table path — full rate data available.
+    input_rate = rates.get("input_per_m")
+    output_rate = rates.get("output_per_m")
+
+    if input_rate is None or output_rate is None:
+        return None
+
+    cost = (
+        Decimal(input_tokens) * input_rate / _PER_M
+        + Decimal(output_tokens) * output_rate / _PER_M
+    )
+
+    if cache_read_tokens > 0:
+        cache_read_rate = rates.get("cache_read_per_m")
+        if cache_read_rate is None:
+            return None
+        cost += Decimal(cache_read_tokens) * cache_read_rate / _PER_M
+
+    if cache_write_tokens > 0:
+        cache_write_rate = rates.get("cache_write_per_m")
+        if cache_write_rate is None:
+            return None
+        cost += Decimal(cache_write_tokens) * cache_write_rate / _PER_M
+
+    if speed == "fast" and model in _FAST_ELIGIBLE_MODELS:
+        cost *= 2
+
+    return cost
