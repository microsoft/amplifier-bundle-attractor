// 00-convergence-loop.dot -- Tutorial 00: The Convergence Loop
//
// THE SHAPE: attempt -> evidence gate -> corrective back-edge -> done
//
// This is the attractor pattern: a worker node produces an artifact, a
// deterministic tool gate checks it mechanically, and if the check fails
// the gate routes back to the worker for another attempt.  The exit is
// structurally unreachable until the tool reports success.
//
// Why loops beat chains: a 6-step linear chain of 0.90-probability nodes
// has ~0.53 end-to-end reliability.  One corrective loop around the same
// steps raises that to ~0.94.  The gate is not a style choice; it is the
// mechanism that turns a flowchart into an attractor.
//
// Walk-up invocation (run from the repo root):
//
//   DOT="$PWD/examples/pipelines/00-convergence-loop.dot"
//   mkdir -p /tmp/attractor-demo && cd /tmp/attractor-demo
//   dot-runner run "$DOT" --worker coding-agent --cwd .
//
// Two things about the command shape:
//   - Capture $DOT absolute BEFORE cd -- the path resolves from your
//     current directory, so a relative path breaks after cd.
//   - Process cwd must equal --cwd for box-node pipelines -- the agent
//     orchestrator roots writes at the process cwd.
//
// Goal: write a Python function count_words(text) that counts whitespace-
// separated words and passes pytest.  Self-contained -- no --param needed.

digraph convergence_loop {
    graph [
        goal="Write a Python function count_words(text) that counts whitespace-separated words and returns an integer.  Write the function to word_counter.py and write pytest tests to test_word_counter.py.  Run the tests to confirm they pass.",
        default_fidelity="full",
        default_thread_id="dev"
    ]

    // --- Entry ---
    start [shape=Mdiamond, label="Start"]

    // --- Worker ---
    // implement: writes or revises word_counter.py and test_word_counter.py.
    // On retry iterations it reads test_output.txt to see what failed.
    implement [
        label="Implement",
        prompt="You are implementing a small Python task.\n\nGoal: $goal\n\nIf test_output.txt exists, read it -- it holds the latest pytest output and tells you exactly what to fix.\n\nWrite word_counter.py with count_words(text) and test_word_counter.py with at least three pytest test cases (empty string, single word, multiple words).  Make sure the tests will pass before finishing."
    ]

    // --- Evidence gate (parallelogram = tool node) ---
    // test_gate: runs pytest mechanically and echoes a routing label as its
    // last output line.  The engine stores that line in context.tool.last_line,
    // which the outgoing edges condition on.
    //
    // Why a tool gate, not an LLM verdict?  The gate is deterministic: the
    // test suite either passes or it does not.  No LLM self-report can fake
    // a green test run.  This is what makes the exit structurally unreachable
    // until the work is actually done.
    test_gate [
        shape=parallelogram,
        label="pytest",
        tool_command="pytest -q test_word_counter.py > test_output.txt 2>&1 && echo gate_pass || echo gate_fail",
        goal_gate=true
    ]

    // --- Exit ---
    done [shape=Msquare, label="Done"]

    // --- Flow ---
    start -> implement

    // implement always feeds the gate
    implement -> test_gate

    // Gate routes on context.tool.last_line (the last line echoed by the command).
    // "gate_pass" => tests passed, proceed to done.
    // "gate_fail" => tests failed, loop back to implement for another attempt.
    test_gate -> done      [label="tests pass",   condition="context.tool.last_line=gate_pass"]
    test_gate -> implement [label="fix and retry", condition="context.tool.last_line=gate_fail", loop_restart="true"]
}
