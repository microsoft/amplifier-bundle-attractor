// 06-model-stylesheet.dot -- Model selection per node via CSS-like stylesheet.
//
// A pipeline that uses model_stylesheet to assign different models to
// different nodes based on selectors: * (universal), .class, #id, and
// bare shape name.
// Tests: stylesheet parsing, selector specificity, property application,
//        explicit node attribute override, class attribute on nodes.
//
// Model selection note: MOST selectors below use GLOB model ids, which the
// engine resolves against the provider's LIVE model list at run time (newest
// stable match wins) -- NOT a static/hardcoded list. How evergreen a glob is
// depends on whether the provider keeps a stable TIER NAME across generations:
//   - Anthropic (claude-sonnet-*, claude-opus-*) and Gemini (gemini-*-flash):
//     the tier name persists, so the glob tracks new generations forever.
// A bare concrete id (e.g. claude-sonnet-4-6) is NOT resolved -- it is sent to the
// provider as-is and 404s once retired. Pin a concrete id only for locked evals,
// or for a provider INSTANCE (next paragraph), where it is the required form.
//
// PROVIDER INSTANCES -- the .planning selector below is one, on purpose.
// `llm_provider` does not have to name a provider MODULE (anthropic / openai /
// gemini). It can name the `id` of a configured provider INSTANCE: a
// `config.providers[]` entry in the operator's Amplifier settings carrying its
// own base_url, api_key and default_model (`amplifier provider list`). `luna`
// is an instance of provider-openai.
//
// An instance takes a CONCRETE llm_model, never a glob -- this is mechanical,
// not stylistic. A glob routes through unified_llm.resolve_latest_for, whose
// SDK adapters cover the anthropic/openai/gemini triad ONLY; it has no adapter
// for an instance id and fails loud with "no adapter found for provider
// 'luna'". A concrete id is returned unchanged with no catalog call at all.
// So the usual "globs are evergreen, concrete ids rot" advice INVERTS here:
// the instance id is the stable address, and the model behind it moves when
// the operator re-points the instance.
//
// An instance also has to EXIST to be addressed: it is mounted only when the
// run NAMES it, and a run whose merged settings do not define it refuses at
// startup naming the node -- it never falls back to another provider. A graph
// pinning an instance owes its runner a definition (see
// .github/capsule-pipeline/provider-instances.yaml for the shape).
//
// Why luna rather than the openai module: standing repo policy (owner,
// 2026-09-07) is that gpt-5 is not a live choice; address a `-terra` or
// `-luna` instance instead. Measured on one real workload at identical gate
// quality (node-matrix 20260907T164521Z-axes): luna/gpt-5.6-luna/high
// 4.3 min / $0.08, terra/gpt-5.6-terra/high 8.0 min / $7.39,
// openai/gpt-5/high 43.6 min / $7.83.

digraph ModelStylesheet {
    graph [
        goal="Refactor a legacy Python codebase to use modern async patterns",
        label="Model Stylesheet Pipeline",
        model_stylesheet="
            * {
                llm_model: claude-sonnet-*;
                llm_provider: anthropic;
                reasoning_effort: medium;
            }
            .planning {
                llm_model: gpt-5.6-luna;
                llm_provider: luna;
                reasoning_effort: high;
            }
            .code {
                llm_model: claude-sonnet-*;
                llm_provider: anthropic;
            }
            .fast {
                llm_model: gemini-*-flash;
                llm_provider: gemini;
                reasoning_effort: low;
            }
            #critical_review {
                llm_model: claude-opus-*;
                llm_provider: anthropic;
                reasoning_effort: high;
            }
        ",
        default_fidelity="full",
        default_thread_id="model-stylesheet"
    ]
    rankdir=LR

    // Structural nodes
    start [shape=Mdiamond, label="Start"]
    done  [shape=Msquare, label="Done"]

    // Planning node -- .planning class -> routed to the `luna` provider INSTANCE
    // at high reasoning effort (concrete model id: instances take no globs)
    analyze [
        label="Analyze Codebase",
        class="planning",
        prompt="Analyze the legacy codebase and identify all synchronous I/O patterns that should be converted to async. Create a prioritized refactoring plan."
    ]

    // Code node -- .code class -> gets claude-sonnet
    refactor [
        label="Refactor Code",
        class="code",
        prompt="Refactor the identified synchronous patterns to use async/await. Follow the refactoring plan from the analysis phase."
    ]

    // Fast node -- .fast class -> gets gemini-flash with low reasoning
    lint_check [
        label="Lint Check",
        class="fast",
        prompt="Run a quick lint check on the refactored code. Report any style violations or type errors."
    ]

    // ID-targeted node -- #critical_review -> gets claude-opus with high reasoning
    // This overrides the .code class match because #id has higher specificity
    critical_review [
        label="Critical Review",
        class="code",
        prompt="Perform a thorough code review of the async refactoring. Check for race conditions, missing error handling, and proper resource cleanup. This is a critical gate."
    ]

    // Node with explicit attribute override -- node attrs beat stylesheet.
    // NOTE: override BOTH llm_model and llm_provider together. A glob is resolved
    // against the node's provider, so a gemini model glob needs llm_provider=gemini
    // here (the .code class would otherwise supply anthropic and the glob would
    // match nothing). Concrete ids bypass resolution; globs do not.
    quick_fix [
        label="Quick Fix",
        class="code",
        llm_model="gemini-*-flash",
        llm_provider="gemini",
        prompt="Apply quick fixes for any issues found in the critical review."
    ]

    // Flow
    start -> analyze -> refactor -> lint_check -> critical_review -> quick_fix -> done
}
